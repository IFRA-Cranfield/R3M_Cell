<robot name="irb1200" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- PASS ARGUMENTS: -->
  <xacro:arg name="bringup" default="false"/>
  <xacro:property name="bringup" value="$(arg bringup)"/>
  <xacro:arg name="hmi" default="false"/>
  <xacro:property name="hmi" value="$(arg hmi)"/>
  <xacro:arg name="robot_ip" default="0.0.0.0"/>
  <xacro:property name="robot_ip" value="$(arg robot_ip)"/>

  <xacro:arg name="EE" default="true"/>
  <xacro:property name="EE" value="$(arg EE)"/>
  <xacro:arg name="EE_name" default="none"/>
  <xacro:property name="EE_name" value="$(arg EE_name)"/>

  <!-- Include XACRO-MACRO file of the IRB1200: -->
  <xacro:include filename="$(find ros2srrc_robots)/irb1200/urdf/irb1200_macro.urdf.xacro"/>	
  <xacro:irb1200 
    bringup="${bringup}"
    robot_ip="${robot_ip}"
    EE="${EE}"
    EE_name="${EE_name}"
  />

  <!-- Include: IRB1200/GPP5010NC ADAPTER -->
  <link name="adapter">
    <visual>
      <geometry>
        <mesh filename="file://$(find ros2srrc_endeffectors)/gpp5010nc/meshes/gpp5010nc_irb1200_Adapter.dae" />
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find ros2srrc_endeffectors)/gpp5010nc/meshes/gpp5010nc_irb1200_Adapter.dae" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="adapter_joint" type="fixed">
    <origin xyz="0.0 0.0 0.0125" rpy="0 1.5708 3.1416" />
    <parent link="tool0"/>
    <child link="adapter"/>
  </joint>

  <!-- Include XACRO-MACRO file of the GPP5010NC: --> 
  <xacro:include filename="$(find ros2srrc_endeffectors)/gpp5010nc/urdf/gpp5010ncv3_macro.urdf.xacro"/>	
  <xacro:gpp5010nc 
    bringup="${bringup}"
    parent_link="adapter"
  /> 

  <!-- Load ROS 2 Gazebo Plugin -->
  <xacro:unless value="${bringup}">
    
    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <robot_sim_type>gazebo_ros2_control/GazeboSystem</robot_sim_type>

        <!-- IRB1200 Controller -->
        <parameters>$(find ros2srrc_robots)/irb1200/config/controller.yaml</parameters>

        <!-- End-Effector Controller (if needed) -->
        <parameters>$(find ros2srrc_endeffectors)/${EE_name}/config/controller.yaml</parameters>

      </plugin>
    </gazebo>

  </xacro:unless>

  <!-- World: LINK -->
  <link name="world"/>
  
  <!-- ReconCell: FLOOR -->
  <link name="floor">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find r3mcell_amrc_gazebo)/meshes/ReconCell/floor_irb1200.dae" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find r3mcell_amrc_gazebo)/meshes/ReconCell/floor_irb1200.dae" scale="1 1 1" />
      </geometry>
    </collision>
    <inertial>
      <mass value="1000.0"/>
      <inertia ixx="500.0" ixy="500.0" ixz="500.0" iyy="500.0" iyz="500.0" izz="500.0" />
    </inertial>
  </link>
  <joint name="world-floor-fixed" type="fixed">
    <parent link="world"/>
    <child link="floor"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- ReconCell: TallMount -->
  <link name="TallMount">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find r3mcell_amrc_gazebo)/meshes/ReconCell/TallMount.dae" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find r3mcell_amrc_gazebo)/meshes/ReconCell/TallMount.dae" scale="1 1 1" />
      </geometry>
    </collision>
    <inertial>
      <mass value="1000.0"/>
      <inertia ixx="500.0" ixy="500.0" ixz="500.0" iyy="500.0" iyz="500.0" izz="500.0" />
    </inertial>
  </link>
  <joint name="world-TallMount-fixed" type="fixed">
    <parent link="world"/>
    <child link="TallMount"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- IRB1200 - Adapter Plate -->
  <link name="adapter_plate">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find r3mcell_amrc_gazebo)/meshes/ReconCell/irb1200_FloorAdapter.dae" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find r3mcell_amrc_gazebo)/meshes/ReconCell/irb1200_FloorAdapter.dae" scale="1 1 1" />
      </geometry>
    </collision>
    <inertial>
      <mass value="1000.0"/>
      <inertia ixx="500.0" ixy="500.0" ixz="500.0" iyy="500.0" iyz="500.0" izz="500.0" />
    </inertial>
  </link>

  <!-- Floor+Adapter JOINT -->
  <joint name="floor-adapter-fixed" type="fixed">
    <parent link="floor"/>
    <child link="adapter_plate"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- Robot+Adapter JOINT -->
  <joint name="adapter-base_link-fixed" type="fixed">
    <parent link="adapter_plate"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.139" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- ReconCell: WALLS -->
  <link name="walls">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find r3mcell_amrc_gazebo)/meshes/ReconCell/walls_1200.dae" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find r3mcell_amrc_gazebo)/meshes/ReconCell/walls_1200.dae" scale="1 1 1" />
      </geometry>
    </collision>
    <inertial>
      <mass value="1000.0"/>
      <inertia ixx="500.0" ixy="500.0" ixz="500.0" iyy="500.0" iyz="500.0" izz="500.0" />
    </inertial>
  </link>

  <!-- WALLS: FIXED JOINT -->
  <joint name="world-walls-fixed" type="fixed">
    <parent link="world"/>
    <child link="walls"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- R3M AMRC Cell: Cylinder Stacking -> Fixture -->
  <link name="CS_Fixture">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find r3mcell_amrc_gazebo)/meshes/CylinderStacking/CylinderStacking_Fixture.dae" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find r3mcell_amrc_gazebo)/meshes/CylinderStacking/CylinderStacking_Fixture.dae" scale="1 1 1" />
      </geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.0002" ixy="0.0002" ixz="0.0002" iyy="0.0" iyz="0.0" izz="0.0" />
    </inertial>
  </link>
  <joint name="floor-CS_Fixture-fixed" type="fixed">
    <parent link="floor"/>
    <child link="CS_Fixture"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- ARUCO TAG -->
  <xacro:unless value="${bringup}">

    <!-- ARUCO GRID -->
    <link name="aruco_grid">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find r3mcell_amrc_gazebo)/meshes/aruco/arucoGrid_irb1200.dae" scale="1 1 1" />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find r3mcell_amrc_gazebo)/meshes/aruco/arucoGrid_irb1200.dae" scale="1 1 1" />
        </geometry>
      </collision>
      <inertial>
        <mass value="10.0"/>
        <inertia ixx="0.0002" ixy="0.0002" ixz="0.0002" iyy="0.0" iyz="0.0" izz="0.0" />
      </inertial>
    </link>
    <joint name="floor-aruco_grid-fixed" type="fixed">
      <parent link="floor"/>
      <child link="aruco_grid"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </joint>

    <gazebo reference="floor-aruco_grid-fixed">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

  </xacro:unless>

  <!-- ros2srrc_HMI CAMERA -->
  <xacro:if value="${hmi}">
    <xacro:include filename="$(find ros2srrc_hmi)/urdf/hmicamera.urdf.xacro"/>	
    <xacro:HMI_camera 
      x="2.0"
      y="1.10"
      z="1.25"
      roll="0.0"
      pitch="0.35"
      yaw="-2.6"
    />
  </xacro:if>

  <!-- CAMERA -->
  <xacro:unless value="${bringup}">

    <link name="camera_link">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>
      </visual>
      <inertial>
        <mass value="1.0" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0" />
      </inertial>
    </link>
    <joint name="camera_joint" type="fixed">
      <origin xyz="1.60 0.10 1.20" rpy="0 0.95 3.1416"/>
      <parent link="world"/>
      <child link="camera_link"/>
    </joint>

    <gazebo reference="camera_link">
      <sensor name="camera" type="camera">
        <update_rate>30</update_rate>
        <camera name="head">
          <horizontal_fov>1.22</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <plugin filename="libgazebo_ros_camera.so" name="camera_controller">
          <robotNamespace/>
          <alwaysOn>true</alwaysOn>
          <updateRate>0.0</updateRate>
          <cameraName>camera</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>camera</frameName>
          <hackBaseline>0.07</hackBaseline>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:unless>

</robot>