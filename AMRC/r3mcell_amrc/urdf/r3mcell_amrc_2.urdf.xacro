<robot name="irb6640" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- PASS ARGUMENTS: -->
  <xacro:arg name="bringup" default="false"/>
  <xacro:property name="bringup" value="$(arg bringup)"/>
  <xacro:arg name="hmi" default="false"/>
  <xacro:property name="hmi" value="$(arg hmi)"/>
  <xacro:arg name="robot_ip" default="0.0.0.0"/>
  <xacro:property name="robot_ip" value="$(arg robot_ip)"/>

  <xacro:arg name="EE" default="true"/>
  <xacro:property name="EE" value="$(arg EE)"/>
  <xacro:arg name="EE_name" default="none"/>
  <xacro:property name="EE_name" value="$(arg EE_name)"/>

  <xacro:arg name="prefix" default=""/>
  <xacro:property name="prefix" value="$(arg prefix)"/>

  <!-- Include XACRO-MACRO file of the IRB6640: -->
  <xacro:include filename="$(find ros2srrc_robots)/irb6640/urdf/irb6640_macro.urdf.xacro"/>	
  <xacro:irb6640 
    bringup="${bringup}"
    robot_ip="${robot_ip}"
    EE="${EE}"
    EE_name="${EE_name}"
    prefix="${prefix}"
  />

  <!-- Include Link6's extension (CABLE HOLDER): -->
  <link name="${prefix}link_6_ext">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find r3mcell_amrc)/meshes/ReconCell/irb6640_AMRC_link6.dae" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find r3mcell_amrc)/meshes/ReconCell/irb6640_AMRC_link6.dae" scale="1 1 1" />
      </geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="500.0" ixy="500.0" ixz="500.0" iyy="500.0" iyz="500.0" izz="500.0" />
    </inertial>
  </link>
  <joint name="${prefix}link6_ext_fixedjoint" type="fixed">
    <parent link="${prefix}link_6"/>
    <child link="${prefix}link_6_ext"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- Load ROS 2 Gazebo Plugin -->
  <xacro:unless value="${bringup}">
    
    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <robot_sim_type>gazebo_ros2_control/GazeboSystem</robot_sim_type>

        <!-- IRB6640 Controller -->
        <parameters>$(find ros2srrc_robots)/irb6640/config/controller.yaml</parameters>

      </plugin>
    </gazebo>

  </xacro:unless>

  <!-- World: LINK -->
  <link name="world"/>
  
  <!-- ReconCell: FLOOR -->
  <link name="${prefix}floor">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find r3mcell_amrc)/meshes/ReconCell/floor_irb6640.dae" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find r3mcell_amrc)/meshes/ReconCell/floor_irb6640.dae" scale="1 1 1" />
      </geometry>
    </collision>
    <inertial>
      <mass value="1000.0"/>
      <inertia ixx="500.0" ixy="500.0" ixz="500.0" iyy="500.0" iyz="500.0" izz="500.0" />
    </inertial>
  </link>

  <!-- FLOOR: FIXED JOINT -->
  <joint name="${prefix}world-floor-fixed" type="fixed">
    <parent link="world"/>
    <child link="${prefix}floor"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- Robot+Floor JOINT -->
  <joint name="${prefix}floor-base_link-fixed" type="fixed">
    <parent link="${prefix}floor"/>
    <child link="${prefix}base_link"/>
    <origin xyz="0.0 0.0 0.148" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- ReconCell: WALLS -->
  <link name="${prefix}walls">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find r3mcell_amrc)/meshes/ReconCell/walls_6640.dae" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find r3mcell_amrc)/meshes/ReconCell/walls_6640.dae" scale="1 1 1" />
      </geometry>
    </collision>
    <inertial>
      <mass value="1000.0"/>
      <inertia ixx="500.0" ixy="500.0" ixz="500.0" iyy="500.0" iyz="500.0" izz="500.0" />
    </inertial>
  </link>

  <!-- WALLS: FIXED JOINT -->
  <joint name="${prefix}world-walls-fixed" type="fixed">
    <parent link="world"/>
    <child link="${prefix}walls"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- ros2srrc_HMI CAMERA -->
  <xacro:if value="${hmi}">
    <xacro:include filename="$(find ros2srrc_hmi)/urdf/hmicamera.urdf.xacro"/>	
    <xacro:HMI_camera 
      x="3.5"
      y="3.5"
      z="2.5"
      roll="0.0"
      pitch="0.35"
      yaw="-2.5"
    />
  </xacro:if>

</robot>