<?xml version="1.0"?>

<robot name="FullAssembly" xmlns:xacro="http://ros.org/wiki/xacro">

  <link name="FullAssembly">

    <inertial>

      <origin xyz= "0.0 0.0 0.0" rpy="0 0 0"/>
      <mass value= "1.0" />
      <inertia
        ixx="0.01" ixy="0.0"  ixz="0.0"
        iyy="0.01" iyz="0.0"
        izz="0.01" />

    </inertial>

    <collision name="collision">

      <origin xyz= "0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find r3mcell_amrc)/meshes/CylinderStacking/FullAssembly.dae"/>
      </geometry>

    </collision>

    <visual name="visual">

      <origin xyz= "0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find r3mcell_amrc)/meshes/CylinderStacking/FullAssembly.dae"/>
      </geometry>

    </visual>

  </link>

  <gazebo reference="FullAssembly">
    <selfCollide>false</selfCollide>
  </gazebo>

  <!-- LOAD ObjectPose Gazebo (ROS2) PLUGIN: -->
  <gazebo>
    <plugin name="ros2_objectpose_plugin" filename="libros2_objectpose_plugin.so" >
      <ros>
        <namespace>FullAssembly</namespace>
      </ros>
    </plugin>
  </gazebo>

</robot>