<robot name="irb120" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- PASS ARGUMENTS: -->

  <!-- layout -->
  <xacro:arg name="r3mcell_cu_1" default="false"/>
  <xacro:property name="r3mcell_cu_1" value="$(arg r3mcell_cu_1)"/>
  <xacro:arg name="r3mcell_cu_2" default="false"/>
  <xacro:property name="r3mcell_cu_2" value="$(arg r3mcell_cu_2)"/>
  <xacro:arg name="r3mcell_cu_3" default="false"/>
  <xacro:property name="r3mcell_cu_3" value="$(arg r3mcell_cu_3)"/>

  <!-- endeffector -->
  <xacro:arg name="EE_no" default="false"/>
  <xacro:property name="EE_no" value="$(arg EE_no)"/>
  <xacro:arg name="EE_egp64" default="false"/>
  <xacro:property name="EE_egp64" value="$(arg EE_egp64)"/>
  <xacro:arg name="EE_vgr" default="false"/>
  <xacro:property name="EE_vgr" value="$(arg EE_vgr)"/>

  <!-- bringup -->
  <xacro:arg name="bringup" default="false"/>
  <xacro:property name="bringup" value="$(arg bringup)"/>

  <!-- robot_ip -->
  <xacro:arg name="robot_ip" default="0.0.0.0"/>
  <xacro:property name="robot_ip" value="$(arg robot_ip)"/>


  <!-- Include XACRO-MACRO file of the IRB120: -->
  <xacro:include filename="$(find r3mcell_cu_gazebo)/urdf/irb120_macro.urdf.xacro"/>	
  <xacro:irb120 
    prefix=""

    EE_no="${EE_no}"
    EE_egp64="${EE_egp64}"
    EE_vgr="${EE_vgr}"

    bringup="${bringup}"
    robot_ip="${robot_ip}"/>

  <!-- World link -->
  <link name="world"/>
  
  <link name="cell">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find r3mcell_cu_gazebo)/meshes/IALab/IRB120enclosure.dae" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find r3mcell_cu_gazebo)/meshes/IALab/IRB120enclosure.dae" scale="1 1 1" />
      </geometry>
    </collision>
    <inertial>
      <mass value="1000.0"/>
      <inertia ixx="500.0" ixy="500.0" ixz="500.0" iyy="500.0" iyz="500.0" izz="500.0" />
    </inertial>
  </link>
  <joint name="world-cell-fixed" type="fixed">
    <parent link="world"/>
    <child link="cell"/>
    <origin xyz="0.926 -0.124 0.0" rpy="0.0 0.0 0.0" />
  </joint>
  <joint name="cell-base_link-fixed" type="fixed">
    <parent link="cell"/>
    <child link="base_link"/>
    <origin xyz="-0.6506 0.6489 0.8605" rpy="0.0 0.0 0.0" />
  </joint>

  <xacro:if value="${r3mcell_cu_1}">

    <!-- MUST MODIFY: We need a cirular box rather than a square box to avoid conflict with box detections. 
    <link name="ergobox">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find r3mcell_cu_gazebo)/meshes/IALab/ergobox.dae" scale="1 1 1" />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find r3mcell_cu_gazebo)/meshes/IALab/ergobox.dae" scale="1 1 1" />
        </geometry>
      </collision>
      <inertial>
        <mass value="10.0"/>
        <inertia ixx="0.0002" ixy="0.0002" ixz="0.0002" iyy="0.0" iyz="0.0" izz="0.0" />
      </inertial>
    </link>
    <joint name="cell-ergobox-fixed" type="fixed">
      <parent link="cell"/>
      <child link="ergobox"/>
      <origin xyz="-0.3 0.32 0.8605" rpy="0.0 0.0 0.0" />
    </joint>
    -->

  </xacro:if>

  <xacro:if value="${r3mcell_cu_2}">

    <link name="LS_PickingStand">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find r3mcell_cu_gazebo)/meshes/LamStack_UseCase/R3M_LSPickingStand.dae" scale="1 1 1" />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find r3mcell_cu_gazebo)/meshes/LamStack_UseCase/R3M_LSPickingStand.dae" scale="1 1 1" />
        </geometry>
      </collision>
      <inertial>
        <mass value="10.0"/>
        <inertia ixx="0.0002" ixy="0.0002" ixz="0.0002" iyy="0.0" iyz="0.0" izz="0.0" />
      </inertial>
    </link>
    <joint name="cell-LS_PickingStand-fixed" type="fixed">
      <parent link="cell"/>
      <child link="LS_PickingStand"/>
      <origin xyz="-0.425 0.825 0.8605" rpy="0.0 0.0 0.0" />
    </joint>

    <link name="LS_PlacingStand">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find r3mcell_cu_gazebo)/meshes/LamStack_UseCase/R3M_LSPlacingStand.dae" scale="1 1 1" />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find r3mcell_cu_gazebo)/meshes/LamStack_UseCase/R3M_LSPlacingStand.dae" scale="1 1 1" />
        </geometry>
      </collision>
      <inertial>
        <mass value="10.0"/>
        <inertia ixx="0.0002" ixy="0.0002" ixz="0.0002" iyy="0.0" iyz="0.0" izz="0.0" />
      </inertial>
    </link>
    <joint name="cell-LS_PlacingStand-fixed" type="fixed">
      <parent link="cell"/>
      <child link="LS_PlacingStand"/>
      <origin xyz="-0.525 0.325 0.8605" rpy="0.0 0.0 3.1416" />
    </joint>

  </xacro:if>

  <xacro:if value="${r3mcell_cu_3}">

    <link name="CAN_PickingStand">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find r3mcell_cu_gazebo)/meshes/canPP/canPicking.dae" scale="1 1 1" />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find r3mcell_cu_gazebo)/meshes/canPP/canPicking.dae" scale="1 1 1" />
        </geometry>
      </collision>
      <inertial>
        <mass value="10.0"/>
        <inertia ixx="0.0002" ixy="0.0002" ixz="0.0002" iyy="0.0" iyz="0.0" izz="0.0" />
      </inertial>
    </link>
    <joint name="cell-CAN_PickingStand-fixed" type="fixed">
      <parent link="cell"/>
      <child link="CAN_PickingStand"/>
      <origin xyz="-0.425 0.825 0.8605" rpy="0.0 0.0 0.0" />
    </joint>

    <link name="CAN_PlacingStand">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find r3mcell_cu_gazebo)/meshes/canPP/canPlacing.dae" scale="1 1 1" />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find r3mcell_cu_gazebo)/meshes/canPP/canPlacing.dae" scale="1 1 1" />
        </geometry>
      </collision>
      <inertial>
        <mass value="10.0"/>
        <inertia ixx="0.0002" ixy="0.0002" ixz="0.0002" iyy="0.0" iyz="0.0" izz="0.0" />
      </inertial>
    </link>
    <joint name="cell-CAN_PlacingStand-fixed" type="fixed">
      <parent link="cell"/>
      <child link="CAN_PlacingStand"/>
      <origin xyz="-0.425 0.225 0.8605" rpy="0.0 0.0 3.1416" />
    </joint>

  </xacro:if>

  <!-- CAMERA -->
  <xacro:unless value="${bringup}">

    <link name="camera_link">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>
      </visual>
      <inertial>
        <mass value="1.0" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0" />
      </inertial>
    </link>
    <joint name="camera_joint" type="fixed">
      <origin xyz="0.776 0.526 1.90" rpy="0 1.23 3.1416"/>
      <parent link="world"/>
      <child link="camera_link"/>
    </joint>

    <gazebo reference="camera_link">
      <sensor name="camera" type="camera">
        <update_rate>30</update_rate>
        <camera name="head">
          <horizontal_fov>1.22</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <plugin filename="libgazebo_ros_camera.so" name="camera_controller">
          <robotNamespace/>
          <alwaysOn>true</alwaysOn>
          <updateRate>0.0</updateRate>
          <cameraName>camera</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>camera</frameName>
          <hackBaseline>0.07</hackBaseline>
        </plugin>
      </sensor>
    </gazebo>

    <!-- CAMERA for R3M-HMI -->
    <link name="HMI_camera_link">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>
      </visual>
      <inertial>
        <mass value="1.0" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0" />
      </inertial>
    </link>
    <joint name="HMI_camera_joint" type="fixed">
      <origin xyz="2.0 1.5 2.0" rpy="0 0.35 -2.6"/>
      <parent link="world"/>
      <child link="HMI_camera_link"/>
    </joint>

    <gazebo reference="HMI_camera_link">
      <sensor name="HMI_camera" type="camera">
        <update_rate>30</update_rate>
        <camera name="head">
          <horizontal_fov>1.22</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <plugin filename="libgazebo_ros_camera.so" name="HMI_camera_controller">
          <robotNamespace/>
          <alwaysOn>true</alwaysOn>
          <updateRate>0.0</updateRate>
          <cameraName>HMI_camera</cameraName>
          <imageTopicName>HMI_image_raw</imageTopicName>
          <cameraInfoTopicName>HMI_camera_info</cameraInfoTopicName>
          <frameName>HMI_camera</frameName>
          <hackBaseline>0.07</hackBaseline>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:unless>

</robot>